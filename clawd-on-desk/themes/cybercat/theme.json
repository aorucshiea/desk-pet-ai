{
  "schemaVersion": 1,
  "name": "Cyber Cat",
  "author": "",
  "version": "1.0.0",
  "description": "Cyber Cat theme",

  "viewBox": {
    "x": 0,
    "y": 0,
    "width": 500,
    "height": 500
  },

  "eyeTracking": {
    "enabled": false,
    "states": []
  },

  "sleepSequence": {
    "mode": "direct"
  },

  "states": {
    "idle":         ["cybercat-idle.gif"],
    "thinking":     ["cybercat-thinking.gif"],
    "working":      ["cybercat-working.gif"],
    "juggling":     ["cybercat-juggling.gif"],
    "error":        ["cybercat-error.gif"],
    "attention":    [
      "cybercat-happy.gif",
      { "file": "cybercat-happy.gif", "emotion": "happy" },
      { "file": "cybercat-thinking.gif", "emotion": "curious" },
      { "file": "cybercat-error.gif", "emotion": "sad" },
      { "file": "cybercat-conducting.gif", "emotion": "excited" },
      { "file": "cybercat-annoying.gif", "emotion": "mad" }
    ],
    "notification": ["cybercat-notification.gif"],
    "sleeping":     ["cybercat-sleeping.gif"],
    "carrying":     ["cybercat-carrying.gif"],
    "sweeping":     ["cybercat-sweeping.gif"]
  },

  "workingTiers": [
    { "minSessions": 3, "file": "cybercat-building.gif" },
    { "minSessions": 2, "file": "cybercat-juggling.gif" },
    { "minSessions": 1, "file": "cybercat-working.gif" }
  ],

  "jugglingTiers": [
    { "minSessions": 2, "file": "cybercat-conducting.gif" },
    { "minSessions": 1, "file": "cybercat-juggling.gif" }
  ],

  "reactions": {
    "drag":      { "file": "cybercat-dragging.gif" },
    "annoyed":   { "file": "cybercat-annoying.gif", "duration": 3500 }
  },

  "hitBoxes": {
    "default":  { "x": 40, "y": 20, "w": 240, "h": 280 },
    "sleeping": { "x": 40, "y": 80, "w": 240, "h": 220 }
  },
  "sleepingHitboxFiles": ["cybercat-sleeping.gif"],

  "timings": {
    "mouseIdleTimeout": 20000,
    "mouseSleepTimeout": 60000
  },

  "miniMode": {
    "supported": true,
    "offsetRatio": 0.42,
    "states": {
      "mini-idle":       ["cybercat-mini-idle.gif"],
      "mini-working":    ["cybercat-mini-working.gif"],
      "mini-enter":      ["cybercat-mini-idle.gif"],
      "mini-enter-sleep": ["cybercat-mini-sleeping.gif"],
      "mini-crabwalk":   ["cybercat-mini-idle.gif"],
      "mini-peek":       ["cybercat-mini-idle.gif"],
      "mini-alert":      ["cybercat-mini-alert.gif"],
      "mini-happy":      ["cybercat-mini-happy.gif"],
      "mini-sleep":      ["cybercat-mini-sleeping.gif"]
    }
  },

  "visibleBottomRatio": 0.72,
  "fileVisibleBottomRatio": {
    "cybercat-annoying.gif": 0.716,
    "cybercat-building.gif": 0.744,
    "cybercat-carrying.gif": 0.713,
    "cybercat-conducting.gif": 0.725,
    "cybercat-dragging.gif": 0.941,
    "cybercat-error.gif": 0.688,
    "cybercat-happy.gif": 0.719,
    "cybercat-idle.gif": 0.703,
    "cybercat-juggling.gif": 0.697,
    "cybercat-mini-alert.gif": 0.744,
    "cybercat-mini-happy.gif": 0.762,
    "cybercat-mini-idle.gif": 0.772,
    "cybercat-mini-sleeping.gif": 0.659,
    "cybercat-mini-working.gif": 0.775,
    "cybercat-notification.gif": 0.709,
    "cybercat-sleeping.gif": 0.706,
    "cybercat-sweeping.gif": 0.731,
    "cybercat-thinking.gif": 0.703,
    "cybercat-working.gif": 0.731
  },
  "objectScale": {
    "widthRatio": 0.55,
    "heightRatio": 0.55,
    "imgWidthRatio": 0.6,
    "objBottom": 0.05,
    "imgBottom": 0.05,
    "offsetX": 0.2,
    "offsetY": 0.25
  }
}
