{
  "schemaVersion": 1,
  "name": "Zero",
  "author": "anim-engine (Qwen-Image-2.1 + MiniMax H3 video pipeline)",
  "version": "0.1.0",
  "description": "Zero — a floating snow-drop companion generated by the video-model animation engine. More states are being grown.",

  "viewBox": {
    "x": 0,
    "y": 0,
    "width": 500,
    "height": 500
  },

  "eyeTracking": {
    "enabled": false,
    "states": []
  },

  "sleepSequence": {
    "mode": "direct"
  },

  "states": {
    "idle":      ["zero-idle.gif"],
    "thinking":  ["zero-idle.gif"],
    "working":   ["zero-idle.gif"],
    "attention": [
      "zero-idle.gif",
      { "file": "zero-idle.gif", "emotion": "happy" },
      { "file": "zero-idle.gif", "emotion": "curious" },
      { "file": "zero-idle.gif", "emotion": "sad" },
      { "file": "zero-idle.gif", "emotion": "excited" },
      { "file": "zero-idle.gif", "emotion": "mad" }
    ],
    "notification": ["zero-idle.gif"],
    "error":     { "fallbackTo": "idle" },
    "sleeping":  { "fallbackTo": "idle" }
  },

  "hitBoxes": {
    "default":  { "x": 100, "y": 50, "w": 300, "h": 380 },
    "sleeping": { "x": 100, "y": 50, "w": 300, "h": 380 }
  },

  "timings": {
    "mouseIdleTimeout": 20000,
    "mouseSleepTimeout": 60000
  },

  "miniMode": {
    "supported": false
  },

  "objectScale": {
    "widthRatio": 0.55,
    "heightRatio": 0.55,
    "imgWidthRatio": 0.6,
    "objBottom": 0.05,
    "imgBottom": 0.05,
    "offsetX": 0.2,
    "offsetY": 0.25
  }
}
