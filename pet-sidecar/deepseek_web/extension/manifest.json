{
  "manifest_version": 3,
  "name": "DeepSeek Web Bridge",
  "version": "0.4.2",
  "description": "Bridge a logged-in DeepSeek web chat tab to a local OpenAI-compatible endpoint.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://chat.deepseek.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
